[Unit]
Description=SPADA Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/spada-bot
ExecStart=/home/spada-bot/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

# Logging
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
