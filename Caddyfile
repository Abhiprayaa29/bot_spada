# Caddyfile for SPADA Dashboard
# Place at /etc/caddy/Caddyfile on your GCP VM
# Caddy auto-provisions HTTPS via Let's Encrypt

# Option 1: Use your domain (recommended)
# Replace yourdomain.com with your actual domain
# dashboard.yourdomain.com {
#     reverse_proxy localhost:8080
# }

# Option 2: Use IP address (no HTTPS - for local/internal only)
# For Telegram Web App, you NEED a domain with HTTPS.
# This config is for local dev/testing only.
:8080 {
    reverse_proxy localhost:8080
}

# Option 3: With a domain (copy this block and replace domain)
# spada-bot.yourdomain.com {
#     reverse_proxy localhost:8080
# }
