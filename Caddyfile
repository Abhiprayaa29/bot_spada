# Caddyfile for SPADA Dashboard
# Caddy auto-provisions HTTPS via Let's Encrypt (requires domain)
# Binary: ~/bin/caddy (v2.10.1)
# Usage: ~/bin/caddy run --config /home/abdillahabhi/Documents/bot_spada/Caddyfile

# ── Localhost testing (no HTTPS, just reverse proxy) ────────
:8080 {
    reverse_proxy localhost:8088
}

# ── Domain mode (uncomment + replace with your domain) ──────
# Point your domain A record to this server's public IP.
# Caddy will auto-provision HTTPS via Let's Encrypt.
#
# spada.yourdomain.com {
#     reverse_proxy localhost:8088
# }
#
# Or for Telegram Web App:
# dashboard.yourdomain.com {
#     reverse_proxy localhost:8088
# }
